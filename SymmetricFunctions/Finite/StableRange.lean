import SymmetricFunctions.Finite.Weighted
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# The specialization kernel and bounded stable range

Finite specialization kills high elementary generators. It becomes invertible
on degree-at-most-`d` pieces when the alphabet has at least `d` variables; it is
not asserted to be injective on the whole symmetric-function ring.
-/

namespace SymmetricFunction

noncomputable section

open MvPolynomial

variable (R : Type*) [CommRing R]

/-- Retain only the first `N` elementary generators using the finite presentation. -/
def truncate (N : ℕ) : SymmetricFunction R →ₐ[R] SymmetricFunction R :=
  (liftSymmetric R N).comp (rho R N)

theorem truncate_e_of_le {N k : ℕ} (hk : k ≤ N) : truncate R N (e k) = e k := by
  cases k with
  | zero => simp
  | succ k =>
    let i : Fin N := ⟨k, by omega⟩
    have hp : (finitePresentation R N).symm (rho R N (e (k + 1))) = X i := by
      apply (finitePresentation R N).injective
      apply Subtype.ext
      simp [finitePresentation_apply, i]
    change finiteLift R N ((finitePresentation R N).symm (rho R N (e (k + 1)))) = _
    rw [hp, finiteLift_X]

theorem truncate_e_of_lt {N k : ℕ} (hk : N < k) : truncate R N (e k) = 0 := by
  change liftSymmetric R N (rho R N (e k)) = 0
  rw [rho_e_eq_zero R hk, map_zero]

theorem truncate_e (N k : ℕ) :
    truncate R N (e k) = if k ≤ N then e k else 0 := by
  split_ifs with hk
  · exact truncate_e_of_le R hk
  · exact truncate_e_of_lt R (Nat.lt_of_not_ge hk)

/-- The ideal generated by the elementary functions above the alphabet size. -/
def highElementaryIdeal (N : ℕ) : Ideal (SymmetricFunction R) :=
  Ideal.span (e '' {k : ℕ | N < k})

theorem highElementaryIdeal_le_ker (N : ℕ) :
    highElementaryIdeal R N ≤ RingHom.ker (rho R N).toRingHom := by
  apply Ideal.span_le.mpr
  rintro _ ⟨k, hk, rfl⟩
  exact rho_e_eq_zero R hk

theorem quotient_comp_truncate (N : ℕ) :
    (Ideal.Quotient.mkₐ R (highElementaryIdeal R N)).comp (truncate R N) =
      Ideal.Quotient.mkₐ R (highElementaryIdeal R N) := by
  apply algHom_ext
  intro i
  simp only [AlgHom.comp_apply, truncate_e]
  split_ifs with hi
  · rfl
  · rw [map_zero]
    symm
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    exact Ideal.subset_span ⟨(i : ℕ), Nat.lt_of_not_ge hi, rfl⟩

/-- The exact specialization kernel, with no coefficient restrictions. -/
theorem ker_rho (N : ℕ) :
    RingHom.ker (rho R N).toRingHom = highElementaryIdeal R N := by
  apply le_antisymm _ (highElementaryIdeal_le_ker R N)
  intro f hf
  have ht : truncate R N f = 0 := by
    change liftSymmetric R N (rho R N f) = 0
    rw [show rho R N f = 0 from hf, map_zero]
  have hq := DFunLike.congr_fun (quotient_comp_truncate R N) f
  rw [AlgHom.comp_apply, ht, map_zero] at hq
  exact Ideal.Quotient.eq_zero_iff_mem.mp hq.symm

theorem truncate_of_homogeneous {N d : ℕ} (hd : d ≤ N)
    {f : SymmetricFunction R} (hf : IsHomogeneous f d) : truncate R N f = f := by
  classical
  have hh : ∀ p : MvPolynomial ℕ+ R,
      p.IsWeightedHomogeneous (fun i : ℕ+ => (i : ℕ)) d →
      truncate R N ((polynomialEquiv R).symm p) = (polynomialEquiv R).symm p := by
    intro p hp
    induction hp using MvPolynomial.IsWeightedHomogeneous.induction_on with
    | zero => simp
    | add p q hp hq ihp ihq => simp [ihp, ihq]
    | monomial a r ha =>
      simp only [MvPolynomial.monomial_eq, Finsupp.prod, map_mul, map_prod, map_pow,
        polynomialEquiv_symm_X]
      rw [show (polynomialEquiv R).symm (C r) = algebraMap R (SymmetricFunction R) r from
        (polynomialEquiv R).symm.commutes r, AlgHom.commutes]
      congr 1
      apply Finset.prod_congr rfl
      intro i hi
      have hw := Finsupp.le_weight_of_ne_zero' (fun i : ℕ+ => (i : ℕ))
        (Finsupp.mem_support_iff.mp hi)
      rw [ha] at hw
      rw [truncate_e_of_le R (hw.trans hd)]
  simpa using hh (polynomialEquiv R f) hf

theorem truncate_of_mem_degreeLE {N d : ℕ} (hd : d ≤ N)
    {f : SymmetricFunction R} (hf : f ∈ degreeLE R d) : truncate R N f = f := by
  have hle : degreeLE R d ≤
      LinearMap.ker ((truncate R N).toLinearMap - LinearMap.id) := by
    refine iSup_le fun k => iSup_le fun hk => ?_
    intro g hg
    change truncate R N g - g = 0
    exact sub_eq_zero.mpr (truncate_of_homogeneous R (hk.trans hd) hg)
  exact sub_eq_zero.mp (hle hf)

/-- The target of the stable-range equivalence: symmetric polynomials of bounded total degree. -/
def finiteDegreeLE (N d : ℕ) : Submodule R (symmetricSubalgebra (Fin N) R) :=
  (restrictTotalDegree (Fin N) R d).comap (symmetricSubalgebra (Fin N) R).val.toLinearMap

@[simp] theorem mem_finiteDegreeLE (N d : ℕ) (p : symmetricSubalgebra (Fin N) R) :
    p ∈ finiteDegreeLE R N d ↔ p.val.totalDegree ≤ d :=
  MvPolynomial.mem_restrictTotalDegree (Fin N) d p.val

theorem rho_mem_finiteDegreeLE (N : ℕ) {d : ℕ} {f : SymmetricFunction R}
    (hf : f ∈ degreeLE R d) : rho R N f ∈ finiteDegreeLE R N d := by
  have hle : degreeLE R d ≤ (finiteDegreeLE R N d).comap (rho R N).toLinearMap := by
    refine iSup_le fun k => iSup_le fun hk => ?_
    intro g hg
    exact (mem_finiteDegreeLE R N d _).mpr
      ((isHomogeneous_rho R N k g hg).totalDegree_le.trans hk)
  exact hle hf

theorem liftSymmetric_mem_degreeLE (N : ℕ) {d : ℕ}
    {p : symmetricSubalgebra (Fin N) R} (hp : p ∈ finiteDegreeLE R N d) :
    liftSymmetric R N p ∈ degreeLE R d := by
  have hdeg := (mem_finiteDegreeLE R N d p).mp hp
  rw [← sum_symmetricComponent R N p, map_sum]
  apply (degreeLE R d).sum_mem
  intro k hk
  have hk' : k ≤ d := (Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)).trans hdeg
  exact homogeneous_le_degreeLE hk'
    (isHomogeneous_liftSymmetric R N k _ (isHomogeneous_symmetricComponent R N k p))

/-- Specialization is a linear equivalence on degree-at-most-`d` pieces when `N ≥ d`. -/
def stableRangeEquiv (N d : ℕ) (hd : d ≤ N) :
    degreeLE R d ≃ₗ[R] finiteDegreeLE R N d where
  toFun f := ⟨rho R N f.val, rho_mem_finiteDegreeLE R N f.property⟩
  invFun p := ⟨liftSymmetric R N p.val, liftSymmetric_mem_degreeLE R N p.property⟩
  left_inv f := Subtype.ext (truncate_of_mem_degreeLE R hd f.property)
  right_inv p := Subtype.ext (rho_liftSymmetric R N p.val)
  map_add' f g := Subtype.ext (map_add (rho R N) f.val g.val)
  map_smul' r f := Subtype.ext (map_smul (rho R N) r f.val)

@[simp] theorem stableRangeEquiv_apply (N d : ℕ) (hd : d ≤ N) (f : degreeLE R d) :
    (stableRangeEquiv R N d hd f : symmetricSubalgebra (Fin N) R) = rho R N f.val := rfl

@[simp] theorem stableRangeEquiv_symm_apply (N d : ℕ) (hd : d ≤ N)
    (p : finiteDegreeLE R N d) :
    ((stableRangeEquiv R N d hd).symm p : SymmetricFunction R) = liftSymmetric R N p.val := rfl

/-- Equality can be tested in a sufficiently large alphabet, with bounds on both inputs. -/
theorem rho_eq_iff_of_degreeLE {N d : ℕ} (hd : d ≤ N) {f g : SymmetricFunction R}
    (hf : f ∈ degreeLE R d) (hg : g ∈ degreeLE R d) : rho R N f = rho R N g ↔ f = g := by
  refine ⟨fun he => ?_, congrArg (rho R N)⟩
  have ht := congrArg (liftSymmetric R N) he
  change truncate R N f = truncate R N g at ht
  rwa [truncate_of_mem_degreeLE R hd hf, truncate_of_mem_degreeLE R hd hg] at ht

/-- A form of the bounded equality test allowing different input bounds. -/
theorem rho_eq_iff_of_bounds {N d₁ d₂ : ℕ} (h₁ : d₁ ≤ N) (h₂ : d₂ ≤ N)
    {f g : SymmetricFunction R} (hf : f ∈ degreeLE R d₁) (hg : g ∈ degreeLE R d₂) :
    rho R N f = rho R N g ↔ f = g :=
  rho_eq_iff_of_degreeLE R le_rfl (degreeLE_mono h₁ hf) (degreeLE_mono h₂ hg)

section Examples

attribute [local irreducible] SymmetricFunction

example (f g : SymmetricFunction R) (hf : f ∈ degreeLE R 0) (hg : g ∈ degreeLE R 0) :
    rho R 0 f = rho R 0 g ↔ f = g := rho_eq_iff_of_degreeLE R le_rfl hf hg

example (N : ℕ) : e (R := R) (N + 1) ∈ RingHom.ker (rho R N).toRingHom :=
  rho_e_eq_zero R (Nat.lt_succ_self N)

end Examples

end

end SymmetricFunction
